<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Trizbort.Avalonia.ViewModels"
        x:Class="Trizbort.Avalonia.Views.Dialogs.AutomapSettingsDialog"
        x:DataType="vm:AutomapSettingsViewModel"
        x:Name="DialogWindow"
        Title="Automap Settings"
        Width="480" Height="420"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="16">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <!-- Transcript File Selection -->
                <TextBlock Text="Transcript File:" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0" Text="{Binding FileName}" Watermark="Path to transcript file..." />
                    <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0"
                            Command="{Binding BrowseTranscriptCommand}"
                            CommandParameter="{Binding #DialogWindow}" />
                </Grid>

                <CheckBox Content="Start from end of file (for active transcripts)"
                          IsChecked="{Binding ContinueTranscript}" />

                <Separator Margin="0,4" />

                <!-- General Options -->
                <CheckBox Content="Transcript is verbose"
                          IsChecked="{Binding VerboseTranscript}" />

                <CheckBox Content="Rooms with same name are same room"
                          Margin="16,0,0,0"
                          IsEnabled="{Binding IsAssumeRoomsWithSameNameEnabled}"
                          IsChecked="{Binding AssumeRoomsWithSameNameAreSameRoom}" />

                <CheckBox Content="Assume two-way connections"
                          IsChecked="{Binding AssumeTwoWayConnections}" />

                <CheckBox Content="Guess exits from room descriptions"
                          IsChecked="{Binding GuessExits}" />

                <Separator Margin="0,4" />

                <!-- Command Triggers -->
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" Margin="0,4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Add Object Command:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AddObjectCommand}" Margin="0,2" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Add Region Command:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding AddRegionCommand}" Margin="0,2" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- OK / Cancel Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
            <Button Content="Start" Width="80" IsDefault="True" IsEnabled="{Binding CanStart}" Click="OnStartClick" />
            <Button Content="Cancel" Width="80" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
