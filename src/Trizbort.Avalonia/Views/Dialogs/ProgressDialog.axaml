<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Trizbort.Avalonia.Views.Dialogs.ProgressDialog"
        Title="Working"
        Width="380" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="16" Spacing="12">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Height="16" />
        <Button x:Name="CancelButton" Classes="dialog-button" Content="_Cancel" IsCancel="True"
                HorizontalAlignment="Right" Click="OnCancelClick" />
    </StackPanel>
</Window>
