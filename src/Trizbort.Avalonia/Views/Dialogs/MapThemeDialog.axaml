<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Trizbort.Avalonia.ViewModels"
        x:Class="Trizbort.Avalonia.Views.Dialogs.MapThemeDialog"
        x:DataType="vm:MapThemeViewModel"
        Title="Map Themes"
        Width="480" Height="420"
        MinWidth="400" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="16">
        <Grid Grid.Row="0" ColumnDefinitions="160,*">
            <!-- Theme List -->
            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Text="Available Themes:" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Theme Details & Options -->
            <Border Grid.Column="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel Spacing="10">
                    <TextBlock Text="Theme Details" FontWeight="SemiBold" FontSize="14" />

                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4" DataContext="{Binding SelectedTheme}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Opacity="0.8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Default Shape:" Opacity="0.8" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DefaultRoomShape}" Margin="0,4,0,0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Room Font:" Opacity="0.8" Margin="0,4,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RoomFont.Name}" Margin="0,4,0,0" />
                    </Grid>

                    <Separator Margin="0,6" />

                    <CheckBox Content="Reset individual room/line styles"
                              IsChecked="{Binding ReplaceIndividualStyles}"
                              ToolTip.Tip="Overrides any custom colors and shapes set on individual rooms/connections to match the theme." />

                    <TextBlock Text="Warning: Some rooms or connections have custom styling. Checking this box will reset them."
                               IsVisible="{Binding HasIndividualStyles}"
                               Foreground="#E65100"
                               FontSize="11" TextWrapping="Wrap" />

                    <Separator Margin="0,6" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Import Theme..." Click="OnImportThemeClick" />
                        <Button Content="Export Theme..." Click="OnExportThemeClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- OK / Cancel Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
            <Button Content="Apply Theme" Width="100" IsDefault="True" Click="OnApplyClick" />
            <Button Content="Cancel" Width="80" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
