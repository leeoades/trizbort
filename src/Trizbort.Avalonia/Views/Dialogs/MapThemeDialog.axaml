<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Trizbort.Avalonia.ViewModels"
        x:Class="Trizbort.Avalonia.Views.Dialogs.MapThemeDialog"
        x:DataType="vm:MapThemeViewModel"
        Title="Map Themes"
        Width="640" Height="520"
        MinWidth="544" MinHeight="442"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="16">
        <Grid Grid.Row="0" ColumnDefinitions="200,12,*">
            <!-- Theme list -->
            <HeaderedContentControl Grid.Column="0" Classes="group" Header="Theme">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="0,8,0,0" Text="{Binding CurrentMatchText}" />
                    <Label DockPanel.Dock="Top" Classes="field-label" Content="_Available themes:" Target="{Binding #ThemeList}" />
                    <ListBox x:Name="ThemeList" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </HeaderedContentControl>

            <Grid Grid.Column="2" RowDefinitions="Auto,12,*">
                <!-- Details -->
                <HeaderedContentControl Grid.Row="0" Classes="group" Header="Details">
                    <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4"
                          DataContext="{Binding SelectedTheme}">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Opacity="0.8" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Name}" FontWeight="SemiBold" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Default shape:" Opacity="0.8" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DefaultRoomShape}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Room font:" Opacity="0.8" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RoomFont.Name}" />
                    </Grid>
                </HeaderedContentControl>

                <!-- Options -->
                <HeaderedContentControl Grid.Row="2" Classes="group" Header="Options">
                    <StackPanel Spacing="8">
                        <CheckBox Content="_Reset individual room/line styles"
                                  IsChecked="{Binding ReplaceIndividualStyles}"
                                  ToolTip.Tip="Overrides any custom colors and shapes set on individual rooms/connections to match the theme." />

                        <TextBlock x:Name="WarningText" Classes="hint" />

                        <Separator />

                        <WrapPanel Orientation="Horizontal">
                            <Button Content="_Import Theme..." Margin="0,0,8,8" Click="OnImportThemeClick" />
                            <Button x:Name="ExportSelectedButton" Content="E_xport Selected Theme..." Margin="0,0,8,8" Click="OnExportThemeClick" />
                            <Button Content="Export _Current Map Theme..." Margin="0,0,8,8" Click="OnExportCurrentThemeClick"
                                    ToolTip.Tip="Saves the map's current look as a theme file." />
                            <Button Content="Infer _Default Room Style..." Margin="0,0,8,8" Click="OnInferStyleClick"
                                    ToolTip.Tip="Promotes room styling shared by most rooms to the map default." />
                        </WrapPanel>
                    </StackPanel>
                </HeaderedContentControl>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Classes="dialog-button" Content="_Apply Theme" IsDefault="True" Click="OnApplyClick" />
            <Button Classes="dialog-button" Content="_Cancel" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
