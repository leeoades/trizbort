<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Trizbort.Avalonia.Views.Dialogs.TidyMapDialog"
        Title="Tidy Map"
        Width="460" Height="420"
        MinWidth="360" MinHeight="200"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- Buttons stay at the bottom; the options scroll when a tiling window manager squeezes the dialog. -->
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8"
                    Margin="0,12,0,0">
            <Button x:Name="TidyButton" Classes="dialog-button" Content="_Tidy" IsDefault="True" Click="OnTidyClick" />
            <Button Classes="dialog-button" Content="_Cancel" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <HeaderedContentControl Classes="group" Header="Rooms">
                    <StackPanel Spacing="8">
                        <RadioButton x:Name="WholeMapRadio" GroupName="TidyRooms" Content="The _whole map" />
                        <RadioButton x:Name="SelectedRadio" GroupName="TidyRooms" Content="The _selected rooms"
                                     ToolTip.Tip="Only the selected rooms move; the rest of the map stays where it is." />
                        <TextBlock x:Name="NoSelectionHint" Classes="hint" TextWrapping="Wrap"
                                   Text="Select two or more rooms to tidy just those." />
                    </StackPanel>
                </HeaderedContentControl>

                <HeaderedContentControl Classes="group" Header="Method">
                    <StackPanel Spacing="4">
                        <RadioButton x:Name="QuickRadio" GroupName="TidyMethod" Content="Step by step (_quick)" />
                        <TextBlock Classes="hint" TextWrapping="Wrap" Margin="28,0,0,8"
                                   Text="Moves rooms a step at a time while that makes the map read better, like the tidy while automapping but free to move rooms further. Keeps the map familiar. A few seconds at most." />
                        <RadioButton x:Name="ThoroughRadio" GroupName="TidyMethod" Content="Solver (t_horough)" />
                        <TextBlock Classes="hint" TextWrapping="Wrap" Margin="28,0,0,0"
                                   Text="Works the whole layout out again in one go with a constraint solver, then polishes it step by step. Can untangle layouts the quick tidy gets stuck on, but may move rooms a long way. Takes about six seconds." />
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
