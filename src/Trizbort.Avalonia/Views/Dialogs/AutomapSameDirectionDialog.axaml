<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Trizbort.Avalonia.ViewModels"
        x:Class="Trizbort.Avalonia.Views.Dialogs.AutomapSameDirectionDialog"
        x:DataType="vm:AutomapSameDirectionViewModel"
        Title="Automapping"
        Width="600" SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid ColumnDefinitions="*,16,260" Margin="16">
        <TextBlock Grid.Column="0" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Top" />

        <StackPanel Grid.Column="2" Spacing="8">
            <Button x:Name="KeepExistingButton" Classes="dialog-button" HorizontalAlignment="Stretch"
                    IsDefault="True" Content="{Binding KeepExistingButtonText}" Click="OnKeepExistingClick" />
            <Button Classes="dialog-button" HorizontalAlignment="Stretch"
                    Content="{Binding KeepNewButtonText}" Click="OnKeepNewClick" />
            <Button Classes="dialog-button" HorizontalAlignment="Stretch"
                    Content="Keep _Both" Click="OnKeepBothClick" />
            <Button Classes="dialog-button" HorizontalAlignment="Stretch"
                    IsVisible="{Binding CanSplit}" Content="{Binding MovesButtonText}" Click="OnMovesClick"
                    ToolTip.Tip="The room you left moves, taking you with it (a lift, a car, a train): show it at this stop too, as a copy with its name, and keep track of which stop you're at from the way you go out" />
            <Button Classes="dialog-button" HorizontalAlignment="Stretch"
                    IsVisible="{Binding CanSplit}" Content="{Binding SplitButtonText}" Click="OnSplitClick"
                    ToolTip.Tip="The room you left is two places that look alike (a lift): make it two rooms, the second reached from the first by what you did there, and join the new room to the second" />
        </StackPanel>
    </Grid>
</Window>
