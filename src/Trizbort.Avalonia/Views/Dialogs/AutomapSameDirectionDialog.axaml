<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Trizbort.Avalonia.ViewModels"
        x:Class="Trizbort.Avalonia.Views.Dialogs.AutomapSameDirectionDialog"
        x:DataType="vm:AutomapSameDirectionViewModel"
        Title="Automapping"
        Width="680" Height="380"
        MinWidth="520" MinHeight="320"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Grid RowDefinitions="Auto,12,*,12,Auto" Margin="16">
        <TextBlock Grid.Row="0" Text="{Binding Message}" TextWrapping="Wrap" />

        <Grid Grid.Row="2" ColumnDefinitions="260,16,*">
            <!-- the answers on the left; the one picked explained on the right -->
            <ListBox Grid.Column="0" x:Name="OptionList" ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:SameDirectionOption">
                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="ExplanationText" Text="{Binding Explanation}" TextWrapping="Wrap" />
                    <StackPanel Spacing="6" IsVisible="{Binding ShowsMovingChoice}">
                        <RadioButton GroupName="Moving" IsChecked="{Binding MovesAsStops}">
                            <TextBlock Text="{Binding MovesAsStopsText}" TextWrapping="Wrap" />
                        </RadioButton>
                        <RadioButton GroupName="Moving" IsChecked="{Binding MovesAsTwoRooms}">
                            <TextBlock Text="{Binding MovesAsTwoRoomsText}" TextWrapping="Wrap" />
                        </RadioButton>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="dialog-button" Content="OK" IsDefault="True" Command="{Binding OkCommand}" />
            <Button Classes="dialog-button" Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}"
                    ToolTip.Tip="Map nothing for this move: automap carries on from the next room it can place" />
        </StackPanel>
    </Grid>
</Window>
