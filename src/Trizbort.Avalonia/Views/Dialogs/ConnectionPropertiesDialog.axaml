<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Trizbort.Avalonia.ViewModels"
        xmlns:controls="using:Trizbort.Avalonia.Controls"
        xmlns:conv="using:Trizbort.Avalonia.Converters"
        x:Class="Trizbort.Avalonia.Views.Dialogs.ConnectionPropertiesDialog"
        x:DataType="vm:ConnectionPropertiesViewModel"
        Title="Connection Properties"
        Width="520" Height="700"
        MinWidth="442" MinHeight="595"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="16" Grid.IsSharedSizeScope="True">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" RowSpacing="12">
                <!-- Name -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,12,*">
                    <Label Grid.Column="0" Classes="field-label" Content="_Name:" Target="{Binding #NameBox}" />
                    <TextBox Grid.Column="2" x:Name="NameBox" Text="{Binding ConnectionName}" />
                </Grid>

                <!-- Style -->
                <HeaderedContentControl Grid.Row="1" Classes="group" Header="Style">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="24">
                            <CheckBox Content="_Dotted" IsChecked="{Binding IsDotted}" />
                            <CheckBox Content="One Wa_y Arrow" IsChecked="{Binding IsDirectional}" />
                        </StackPanel>
                        <Grid ColumnDefinitions="Auto,12,*">
                            <Label Grid.Column="0" Classes="field-label" Content="_Color:" Target="{Binding #LineColorButton}" />
                            <controls:ColorPickerButton Grid.Column="2" x:Name="LineColorButton"
                                                        SelectedColor="{Binding ConnectionColor}" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- Text -->
                <HeaderedContentControl Grid.Row="2" Classes="group" Header="Text">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,12,*,12,*" RowDefinitions="Auto,Auto" RowSpacing="2">
                            <Label Grid.Row="0" Grid.Column="0" Content="_Start:" Target="{Binding #StartBox}" />
                            <TextBox Grid.Row="1" Grid.Column="0" x:Name="StartBox" Text="{Binding StartText}" ToolTip.Tip="Text shown near the start of the connection line." />
                            <Label Grid.Row="0" Grid.Column="2" Content="Midd_le:" Target="{Binding #MidBox}" />
                            <TextBox Grid.Row="1" Grid.Column="2" x:Name="MidBox" Text="{Binding MidText}" ToolTip.Tip="Text shown at the middle of the connection line." />
                            <Label Grid.Row="0" Grid.Column="4" Content="_End:" Target="{Binding #EndBox}" />
                            <TextBox Grid.Row="1" Grid.Column="4" x:Name="EndBox" Text="{Binding EndText}" ToolTip.Tip="Text shown near the end of the connection line." />
                        </Grid>

                        <!-- Presets: radios track the Start/Middle/End text -->
                        <WrapPanel Orientation="Horizontal">
                            <RadioButton Margin="0,0,16,0" GroupName="TextPreset" Content="_Up / Down"
                                         IsChecked="{Binding SelectedPreset, Converter={x:Static conv:TextPresetConverter.Instance}, ConverterParameter={x:Static vm:TextPreset.UpDown}}" />
                            <RadioButton Margin="0,0,16,0" GroupName="TextPreset" Content="Do_wn / Up"
                                         IsChecked="{Binding SelectedPreset, Converter={x:Static conv:TextPresetConverter.Instance}, ConverterParameter={x:Static vm:TextPreset.DownUp}}" />
                            <RadioButton Margin="0,0,16,0" GroupName="TextPreset" Content="_In / Out"
                                         IsChecked="{Binding SelectedPreset, Converter={x:Static conv:TextPresetConverter.Instance}, ConverterParameter={x:Static vm:TextPreset.InOut}}" />
                            <RadioButton Margin="0,0,16,0" GroupName="TextPreset" Content="Ou_t / In"
                                         IsChecked="{Binding SelectedPreset, Converter={x:Static conv:TextPresetConverter.Instance}, ConverterParameter={x:Static vm:TextPreset.OutIn}}" />
                            <RadioButton Margin="0,0,16,0" GroupName="TextPreset" Content="Custo_m"
                                         IsChecked="{Binding SelectedPreset, Converter={x:Static conv:TextPresetConverter.Instance}, ConverterParameter={x:Static vm:TextPreset.Custom}}" />
                            <Button Content="Clear te_xt" Click="OnClearTextClick" />
                        </WrapPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- Door -->
                <StackPanel Grid.Row="3" Spacing="8">
                    <CheckBox Content="Doo_r" IsChecked="{Binding HasDoor}" />
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="16,0,0,0" IsEnabled="{Binding HasDoor}">
                        <CheckBox Content="Open_able" IsChecked="{Binding Openable}" />
                        <CheckBox Content="_Open" IsChecked="{Binding Open}" />
                        <CheckBox Content="Locka_ble" IsChecked="{Binding Lockable}" />
                        <CheckBox Content="Loc_ked" IsChecked="{Binding Locked}" />
                    </StackPanel>
                </StackPanel>

                <!-- Description (label above, multi-line) -->
                <Label Grid.Row="4" Content="Descri_ption:" Target="{Binding #DescriptionBox}" />
                <TextBox Grid.Row="5" x:Name="DescriptionBox" Text="{Binding ConnectionDescription}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                         VerticalContentAlignment="Top" />
            </Grid>
        </ScrollViewer>

        <!-- OK / Cancel Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Classes="dialog-button" Content="OK" IsDefault="True" Click="OnOkClick" />
            <Button Classes="dialog-button" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
