<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Trizbort.Avalonia.ViewModels"
        xmlns:controls="using:Trizbort.Avalonia.Controls"
        x:Class="Trizbort.Avalonia.Views.Dialogs.ConnectionPropertiesDialog"
        x:DataType="vm:ConnectionPropertiesViewModel"
        Title="Connection Properties"
        Width="480" Height="480"
        MinWidth="420" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="16">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <!-- General -->
                <HeaderedContentControl Header="General">
                    <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto" Margin="0,4">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ConnectionName}" Margin="0,2" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionDescription}" Margin="0,2" />
                    </Grid>
                </HeaderedContentControl>

                <!-- Line Style & Direction -->
                <HeaderedContentControl Header="Line Style &amp; Direction">
                    <WrapPanel Margin="0,4">
                        <CheckBox Content="One-Way (Directional)" IsChecked="{Binding IsDirectional}" Margin="0,0,16,0" />
                        <CheckBox Content="Dotted Line" IsChecked="{Binding IsDotted}" />
                    </WrapPanel>
                </HeaderedContentControl>

                <!-- Text Labels & Presets -->
                <HeaderedContentControl Header="Text Labels">
                    <StackPanel Spacing="6" Margin="0,4">
                        <Grid ColumnDefinitions="*,8,*,8,*">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Start:" FontSize="11" />
                                <TextBox Text="{Binding StartText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="2">
                                <TextBlock Text="Middle:" FontSize="11" />
                                <TextBox Text="{Binding MidText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" Spacing="2">
                                <TextBlock Text="End:" FontSize="11" />
                                <TextBox Text="{Binding EndText}" />
                            </StackPanel>
                        </Grid>

                        <!-- Presets -->
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                            <TextBlock Text="Presets:" VerticalAlignment="Center" FontSize="11" Opacity="0.8" />
                            <Button Content="Up / Down" Height="26" FontSize="11" Click="OnPresetUpDownClick" />
                            <Button Content="Down / Up" Height="26" FontSize="11" Click="OnPresetDownUpClick" />
                            <Button Content="In / Out" Height="26" FontSize="11" Click="OnPresetInOutClick" />
                            <Button Content="Out / In" Height="26" FontSize="11" Click="OnPresetOutInClick" />
                            <Button Content="Clear" Height="26" FontSize="11" Click="OnPresetClearClick" />
                        </StackPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- Door & Lock -->
                <HeaderedContentControl Header="Door &amp; Lock Status">
                    <StackPanel Spacing="6" Margin="0,4">
                        <CheckBox Content="Has Door" IsChecked="{Binding HasDoor}" />
                        <WrapPanel Margin="16,0,0,0" IsEnabled="{Binding HasDoor}">
                            <CheckBox Content="Openable" IsChecked="{Binding Openable}" Margin="0,0,16,0" />
                            <CheckBox Content="Open" IsChecked="{Binding Open}" Margin="0,0,16,0" />
                            <CheckBox Content="Lockable" IsChecked="{Binding Lockable}" Margin="0,0,16,0" />
                            <CheckBox Content="Locked" IsChecked="{Binding Locked}" />
                        </WrapPanel>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- Colour -->
                <HeaderedContentControl Header="Colour">
                    <Grid ColumnDefinitions="100,*" Margin="0,4">
                        <TextBlock Grid.Column="0" Text="Line Colour:" VerticalAlignment="Center" />
                        <controls:ColorPickerButton Grid.Column="1" SelectedColor="{Binding ConnectionColor}" HorizontalAlignment="Left" />
                    </Grid>
                </HeaderedContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- OK / Cancel Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,12,0,0">
            <Button Content="OK" Width="80" IsDefault="True" Click="OnOkClick" />
            <Button Content="Cancel" Width="80" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
