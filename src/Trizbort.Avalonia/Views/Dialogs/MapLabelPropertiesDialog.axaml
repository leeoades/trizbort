<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Trizbort.Avalonia.ViewModels"
        xmlns:controls="using:Trizbort.Avalonia.Controls"
        x:Class="Trizbort.Avalonia.Views.Dialogs.MapLabelPropertiesDialog"
        x:DataType="vm:MapLabelPropertiesViewModel"
        Title="Map Label Properties"
        Width="440" Height="600"
        MinWidth="374" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Grid RowDefinitions="*,Auto" Margin="16" Grid.IsSharedSizeScope="True">
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12">
                <!-- Text (no group box, as in the reference dialog) -->
                <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="Auto,12,*" RowSpacing="8">
                        <Label Grid.Row="0" Grid.ColumnSpan="3" Classes="field-label" Content="_Text:" Target="{Binding #TextBox}" />
                        <TextBox Grid.Row="1" Grid.ColumnSpan="3" x:Name="TextBox" Text="{Binding Text}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Height="60" />
                        <Label Grid.Row="2" Grid.Column="0" Classes="field-label" Content="Text Colo_ur:" Target="{Binding #TextColorButton}" />
                        <controls:ColorPickerButton Grid.Row="2" Grid.Column="2" x:Name="TextColorButton"
                                                    SelectedColor="{Binding TextColor}" HorizontalAlignment="Left" />
                    </Grid>

                <!-- Outline -->
                <HeaderedContentControl Classes="group" Header="Outline">
                    <StackPanel Spacing="8">
                        <CheckBox Content="_Outline" IsChecked="{Binding HasOutline}" />
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,12,*" RowSpacing="8"
                              IsEnabled="{Binding HasOutline}" Margin="16,0,0,0">
                            <Label Grid.Row="0" Grid.Column="0" Classes="field-label" Content="_Shape:" Target="{Binding #ShapeCombo}" />
                            <ComboBox Grid.Row="0" Grid.Column="2" x:Name="ShapeCombo" ItemsSource="{Binding AvailableShapes}"
                                      SelectedItem="{Binding Shape}" HorizontalAlignment="Stretch" />

                            <Label Grid.Row="1" Grid.Column="0" Classes="field-label" Content="_Line Style:" Target="{Binding #LineStyleCombo}" />
                            <ComboBox Grid.Row="1" Grid.Column="2" x:Name="LineStyleCombo" ItemsSource="{Binding AvailableBorderStyles}"
                                      SelectedItem="{Binding BorderStyle}" HorizontalAlignment="Stretch" />

                            <Label Grid.Row="2" Grid.Column="0" Classes="field-label" Content="_Border Colour:" Target="{Binding #BorderColorButton}" />
                            <controls:ColorPickerButton Grid.Row="2" Grid.Column="2" x:Name="BorderColorButton"
                                                        SelectedColor="{Binding BorderColor}" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </HeaderedContentControl>

                <!-- Background -->
                <HeaderedContentControl Classes="group" Header="Background">
                    <StackPanel Spacing="8">
                        <CheckBox Content="_Fill Background" IsChecked="{Binding HasBackground}" />
                        <Grid ColumnDefinitions="Auto,12,*" IsEnabled="{Binding HasBackground}" Margin="16,0,0,0">
                            <Label Grid.Column="0" Classes="field-label" Content="Fill _Colour:" Target="{Binding #FillColorButton}" />
                            <controls:ColorPickerButton Grid.Column="2" x:Name="FillColorButton"
                                                        SelectedColor="{Binding BackgroundColor}" HorizontalAlignment="Left" />
                        </Grid>
                    </StackPanel>
                </HeaderedContentControl>
            </StackPanel>
        </ScrollViewer>

        <!-- OK / Cancel Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
            <Button Classes="dialog-button" Content="OK" IsDefault="True" Click="OnOkClick" />
            <Button Classes="dialog-button" Content="Cancel" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
