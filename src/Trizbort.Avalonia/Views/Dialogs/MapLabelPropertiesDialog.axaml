<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System"
        xmlns:vm="using:Trizbort.Avalonia.ViewModels"
        xmlns:controls="using:Trizbort.Avalonia.Controls"
        xmlns:misc="using:Trizbort.Domain.Misc"
        xmlns:conv="using:Trizbort.Avalonia.Converters"
        x:Class="Trizbort.Avalonia.Views.Dialogs.MapLabelPropertiesDialog"
        x:DataType="vm:MapLabelPropertiesViewModel"
        Title="Label Properties"
        Width="760" Height="600"
        MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <!-- Text, with a Markdown toolbar and an Add Link panel beside it; outline, background and shape on Style. Lee, 22 Nov 2026. -->
    <Grid x:Name="RootGrid" RowDefinitions="*,Auto" RowSpacing="8" Margin="16" Grid.IsSharedSizeScope="True">
        <TabControl Grid.Row="0" x:Name="Tabs">
            <TabItem Header="Text">
                <DockPanel Margin="0,8,0,0">
                    <!-- the toolbar: what's selected made bold or italic, lines made headings or lists, a table, a link -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <CheckBox DockPanel.Dock="Right" x:Name="MarkdownBox" Content="_Markdown" IsChecked="{Binding Markdown}"
                                  ToolTip.Tip="Format the text with Markdown: # Heading, **bold**, *italic*, - lists, --- rules, tables (| Treasure | Room |, then |---|---|, then a row per line), and links: [[Room Name]] goes to a room when clicked on the map ([[Room Name|other text]] to show other words, [[Maze#42]] for a room that shares its name), [text](https://...) opens a web page." />
                        <StackPanel x:Name="Toolbar" Orientation="Horizontal" Spacing="2">
                            <StackPanel.Styles>
                                <Style Selector="Button.tool">
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="MinWidth" Value="30" />
                                    <Setter Property="Height" Value="28" />
                                    <Setter Property="Padding" Value="6,0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                </Style>
                            </StackPanel.Styles>
                            <Button Classes="tool" x:Name="BoldButton" Click="OnBoldClick" ToolTip.Tip="Bold (Ctrl+B)"
                                    AutomationProperties.Name="Bold">
                                <TextBlock Text="B" FontWeight="Bold" />
                            </Button>
                            <Button Classes="tool" x:Name="ItalicButton" Click="OnItalicClick" ToolTip.Tip="Italic (Ctrl+I)"
                                    AutomationProperties.Name="Italic">
                                <TextBlock Text="I" FontStyle="Italic" FontFamily="Georgia,Times New Roman,serif" />
                            </Button>
                            <Button Classes="tool" x:Name="CodeButton" Click="OnCodeClick" ToolTip.Tip="Code: fixed-width text"
                                    AutomationProperties.Name="Code">
                                <TextBlock Text="&lt;&gt;" FontFamily="Consolas,Menlo,monospace" />
                            </Button>
                            <Border Width="1" Margin="4,4" Background="#CCC" />
                            <Button Classes="tool" x:Name="HeadingButton" Click="OnHeadingClick" ToolTip.Tip="Heading"
                                    AutomationProperties.Name="Heading">
                                <TextBlock Text="H" FontWeight="Bold" />
                            </Button>
                            <Button Classes="tool" x:Name="BulletButton" Click="OnBulletClick" ToolTip.Tip="Bulleted list"
                                    AutomationProperties.Name="Bulleted list">
                                <TextBlock Text="• ≡" />
                            </Button>
                            <Button Classes="tool" x:Name="NumberedButton" Click="OnNumberedClick" ToolTip.Tip="Numbered list"
                                    AutomationProperties.Name="Numbered list">
                                <TextBlock Text="1. ≡" />
                            </Button>
                            <Button Classes="tool" x:Name="RuleButton" Click="OnRuleClick" ToolTip.Tip="A line across"
                                    AutomationProperties.Name="Horizontal rule">
                                <TextBlock Text="—" />
                            </Button>
                            <Border Width="1" Margin="4,4" Background="#CCC" />
                            <Button Classes="tool" x:Name="TableButton" Click="OnTableClick" Content="Insert Table"
                                    ToolTip.Tip="A table with two headings and a few rows to start from" />
                            <Button Classes="tool" x:Name="LinkButton" Click="OnLinkClick" Content="Add Link…"
                                    ToolTip.Tip="A link to a room, or an object's room, chosen from a list (Ctrl+K)" />
                        </StackPanel>
                    </DockPanel>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" x:Name="LabelText" Text="{Binding Text}"
                                 AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap" MinHeight="120"
                                 VerticalContentAlignment="Top"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Text" />

                        <!-- Add Link: rooms or objects, alphabetically, narrowed as you type; or click a room on the map -->
                        <Border Grid.Column="1" x:Name="LinkPanel" IsVisible="{Binding LinkPanelOpen}" Width="260" Margin="8,0,0,0"
                                BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" Padding="8">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" x:Name="CloseLinkButton" Content="✕" Padding="6,0" Height="24"
                                            Click="OnCloseLinkClick" ToolTip.Tip="Close" AutomationProperties.Name="Close the link panel" />
                                    <TextBlock Text="Add a Link" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,6">
                                    <RadioButton GroupName="LinkTo" Content="_Rooms" IsChecked="{Binding LinkToRooms}" />
                                    <RadioButton GroupName="LinkTo" Content="O_bjects" IsChecked="{Binding LinkToObjects}" />
                                </StackPanel>
                                <TextBox DockPanel.Dock="Top" x:Name="LinkSearchBox" Text="{Binding LinkSearch}" Watermark="Search"
                                         Margin="0,0,0,6" AutomationProperties.Name="Search" />
                                <TextBlock DockPanel.Dock="Bottom" Classes="hint" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Or click a room on the map." />
                                <Button DockPanel.Dock="Bottom" x:Name="InsertLinkButton" Content="_Insert Link" HorizontalAlignment="Right"
                                        Margin="0,6,0,0" IsEnabled="{Binding HasLinkChoice}" Click="OnInsertLinkClick" />
                                <ListBox x:Name="LinkList" ItemsSource="{Binding LinkChoices}" SelectedItem="{Binding SelectedLinkChoice}"
                                         DoubleTapped="OnLinkListDoubleTapped" AutomationProperties.Name="Rooms and objects">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="misc:MarkdownLinkChoice">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Where}" Classes="hint" FontSize="11" TextTrimming="CharacterEllipsis"
                                                           IsVisible="{Binding Where, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Style">
                <!-- the look comes from a style (Lee, 24 Nov 2026); just this label can be changed, but it's tucked away -->
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10" Margin="0,8,8,0">
                    <!-- each style shows this label's text as it would look in it (Lee, 25 Nov 2026); the styles as they
                         are, not with this label's changes. Customised, the list gives way to Based on (Lee, 26 Nov 2026) -->
                    <Grid ColumnDefinitions="Auto,*,Auto" IsVisible="{Binding !OwnLookOpen}">
                        <Label Grid.Column="0" Classes="field-label" Content="S_tyle:" Target="{Binding #StyleList}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Classes="hint" Margin="12,0" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Labels in a style all look alike: change the style, and they all change." />
                        <Button Grid.Column="2" x:Name="ManageStylesButton" Content="Mana_ge Styles..." Command="{Binding OpenStyleEditorCommand}" />
                    </Grid>
                    <ListBox x:Name="StyleList" ItemsSource="{Binding StyleOptions}" SelectedItem="{Binding SelectedStyle}"
                             MaxHeight="360" IsVisible="{Binding !OwnLookOpen}" AutomationProperties.Name="Styles, each showing this label in it">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LabelStyleOption">
                                <Grid ColumnDefinitions="150,*" Margin="0,2">
                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Margin="{Binding Depth, Converter={x:Static conv:DepthToIndentConverter.Instance}}" />
                                    <controls:LabelStylePreview Grid.Column="1" Look="{Binding Look}" Sample="{Binding Sample}" Height="48" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- just this label's look: there if wanted, but a style is better (Lee, 25 Nov 2026) -->
                    <!-- closed for a label as its style has it; open for one already changed (Lee, 26 Nov 2026) -->
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !OwnLookOpen}">
                        <Button x:Name="ModifyOwnLookButton" Content="_Modify this label's appearance..." Command="{Binding ModifyOwnLookCommand}" />
                    </StackPanel>
                    <Border x:Name="OwnLookPanel" IsVisible="{Binding OwnLookOpen}" Padding="12" CornerRadius="4"
                            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="This label's appearance" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Classes="hint" Text="(changed from its style)" VerticalAlignment="Center" IsVisible="{Binding HasOwnLook}" />
                            </StackPanel>
                            <!-- the style it starts from: each style's example when open, its name when closed -->
                            <Grid ColumnDefinitions="Auto,12,*,Auto" ColumnSpacing="0">
                                <Label Grid.Column="0" Classes="field-label" Content="_Based on:" Target="{Binding #BasedOnCombo}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="2" x:Name="BasedOnCombo" ItemsSource="{Binding StyleOptions}" SelectedItem="{Binding SelectedStyle}"
                                          MinWidth="220" HorizontalAlignment="Left" MaxDropDownHeight="360"
                                          AutomationProperties.Name="The style this label is based on">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:LabelStyleOption">
                                            <Grid ColumnDefinitions="130,320" Margin="0,2">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                           Margin="{Binding Depth, Converter={x:Static conv:DepthToIndentConverter.Instance}}" />
                                                <controls:LabelStylePreview Grid.Column="1" Look="{Binding Look}" Sample="{Binding Sample}" Height="44" />
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                    <ComboBox.SelectionBoxItemTemplate>
                                        <DataTemplate x:DataType="vm:LabelStyleOption">
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.SelectionBoxItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="3" x:Name="ManageStylesFromOwnButton" Content="Mana_ge Styles..." Command="{Binding OpenStyleEditorCommand}" />
                            </Grid>
                            <!-- the label as it will look, with everything below -->
                            <controls:LabelStylePreview x:Name="OwnLookPreview" Look="{Binding Look}" Sample="{Binding PreviewText}" Height="64"
                                                        AutomationProperties.Name="This label as it will look" />
                            <TextBlock Classes="hint" TextWrapping="Wrap"
                                       Text="Changes here are for this label only. To keep labels alike, save them as a new style (at the bottom)." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Classes="field-label" Content="_Font:" Target="{Binding #LabelFontButton}" />
                        <controls:FontPickerButton Grid.Column="2" x:Name="LabelFontButton" SelectedFont="{Binding Font}" HorizontalAlignment="Left" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Classes="field-label" Content="Text Colo_ur:" Target="{Binding #TextColorButton}" />
                        <controls:ColorPickerButton Grid.Column="2" x:Name="TextColorButton"
                                                    SelectedColor="{Binding TextColor}" HorizontalAlignment="Left" />
                    </Grid>

                    <!-- Outline -->
                    <HeaderedContentControl Classes="group" Header="Outline">
                        <StackPanel Spacing="8">
                            <CheckBox Content="_Enabled" IsChecked="{Binding HasOutline}" />
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="8" Margin="16,0,0,0" IsEnabled="{Binding HasOutline}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label Grid.Row="0" Grid.Column="0" Classes="field-label" Content="Line st_yle:" Target="{Binding #LineStyleCombo}" />
                                <ComboBox Grid.Row="0" Grid.Column="2" x:Name="LineStyleCombo" ItemsSource="{Binding AvailableBorderStyles}"
                                          SelectedItem="{Binding BorderStyle}" HorizontalAlignment="Left" Width="280" />

                                <Label Grid.Row="1" Grid.Column="0" Classes="field-label" Content="Co_lour:" Target="{Binding #BorderColorButton}" />
                                <controls:ColorPickerButton Grid.Row="1" Grid.Column="2" x:Name="BorderColorButton"
                                                            SelectedColor="{Binding BorderColor}" HorizontalAlignment="Left" />
                            </Grid>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- Background -->
                    <HeaderedContentControl Classes="group" Header="Background">
                        <StackPanel Spacing="8">
                            <CheckBox Content="E_nabled" IsChecked="{Binding HasBackground}" />
                            <Grid ColumnDefinitions="Auto,12,*" Margin="16,0,0,0" IsEnabled="{Binding HasBackground}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Classes="field-label" Content="Colou_r:" Target="{Binding #FillColorButton}" />
                                <controls:ColorPickerButton Grid.Column="2" x:Name="FillColorButton"
                                                            SelectedColor="{Binding BackgroundColor}" HorizontalAlignment="Left" />
                            </Grid>
                        </StackPanel>
                    </HeaderedContentControl>

                    <!-- Shape: applies to the outline and the fill, so it is enabled when either is on. -->
                    <Grid ColumnDefinitions="Auto,12,*" IsEnabled="{Binding ShapeEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Classes="field-label" Content="_Shape:" Target="{Binding #ShapeCombo}" />
                        <ComboBox Grid.Column="2" x:Name="ShapeCombo" ItemsSource="{Binding AvailableShapes}"
                                  SelectedItem="{Binding Shape}" HorizontalAlignment="Left" Width="280">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="sys:Object"><TextBlock Text="{Binding ., Converter={x:Static vm:EnumDisplay.Converter}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <TextBlock Classes="hint" Text="Shape applies to outline and background." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Classes="field-label" Content="Text _across:" Target="{Binding #AlignCombo}" />
                        <ComboBox Grid.Column="2" x:Name="AlignCombo" ItemsSource="{Binding AvailableAligns}"
                                  SelectedItem="{Binding Align}" HorizontalAlignment="Left" Width="280">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="sys:Object"><TextBlock Text="{Binding ., Converter={x:Static vm:EnumDisplay.Converter}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" Classes="field-label" Content="Text up/do_wn:" Target="{Binding #VerticalAlignCombo}" />
                        <ComboBox Grid.Column="2" x:Name="VerticalAlignCombo" ItemsSource="{Binding AvailableVerticalAligns}"
                                  SelectedItem="{Binding VerticalAlign}" HorizontalAlignment="Left" Width="280">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="sys:Object"><TextBlock Text="{Binding ., Converter={x:Static vm:EnumDisplay.Converter}}" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                            <!-- the changes as a new style, in Manage Styles: OK there and the label takes it (Lee, 26 Nov 2026) -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SaveAsStyleButton" Content="Sa_ve as a New Style..." Command="{Binding CreateStyleFromLookCommand}"
                                        IsEnabled="{Binding HasOwnLook}" />
                                <Button x:Name="ResetToStyleButton" Content="_Reset to Style" Command="{Binding ResetToStyleCommand}"
                                        IsEnabled="{Binding HasOwnLook}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- OK / Cancel Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
            <Button Classes="dialog-button" Content="_OK" IsDefault="True" Click="OnOkClick" />
            <Button Classes="dialog-button" Content="_Cancel" IsCancel="True" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
