<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Trizbort.Avalonia.ViewModels"
        xmlns:controls="using:Trizbort.Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="700"
        x:Class="Trizbort.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1024" Height="700"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <DockPanel LastChildFill="True">
        <!-- Top Menu & Toolbar Area -->
        <StackPanel DockPanel.Dock="Top">
            <!-- Menu, toolbar and key bindings are generated from the command catalogue (MainWindow.axaml.cs) -->
            <Menu x:Name="MainMenu" />

            <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="4,2">
                <StackPanel x:Name="Toolbar" Orientation="Horizontal" Spacing="2" />
            </Border>

            <!-- a new version of Recast: out, downloading, ready (Lee, 26 Nov 2026) -->
            <!-- hidden when there's nothing to say, or no updates at all (tests) -->
            <Panel DataContext="{Binding Updates}">
            <Border x:Name="UpdateBar" x:DataType="vm:UpdateBarViewModel"
                    IsVisible="{Binding IsVisible, FallbackValue=False}"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="0,0,0,1" Padding="10,5">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Grid.Column="0" Data="{StaticResource IconUpdate}" Width="16" Height="16" Margin="0,0,8,0"
                              VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateMessage" Text="{Binding Message}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <ProgressBar IsVisible="{Binding ShowProgress}" Value="{Binding Progress}" Minimum="0" Maximum="100"
                                     Width="140" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button x:Name="UpdateDownloadButton" Content="Download" IsVisible="{Binding ShowDownload}"
                                Command="{Binding DownloadCommand}" Classes="accent" />
                        <Button x:Name="UpdateRestartButton" Content="{Binding RestartText}" IsVisible="{Binding ShowRestart}"
                                Command="{Binding RestartCommand}" Classes="accent"
                                ToolTip.Tip="Close Recast, install the new version and open it again. You're asked about unsaved changes first." />
                        <Button Content="Try Again" IsVisible="{Binding ShowTryAgain}" Command="{Binding TryAgainCommand}" />
                        <Button Content="Releases Page" IsVisible="{Binding ShowReleases}" Command="{Binding ReleasesCommand}" />
                        <Button Content="What's New" IsVisible="{Binding ShowWhatsNew}" Command="{Binding WhatsNewCommand}" />
                        <Button x:Name="UpdateDismissButton" Content="{Binding DismissText}" Command="{Binding DismissCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
            </Panel>
        </StackPanel>

        <!-- Bottom Status Bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                BorderThickness="0,1,0,0"
                Padding="8,4"
                Height="28">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="11" />
                <TextBlock Grid.Column="1" Text=" | " VerticalAlignment="Center" FontSize="11" Opacity="0.5" Margin="4,0" />
                <TextBlock Grid.Column="2" Text="{Binding ElementCount}" VerticalAlignment="Center" FontSize="11" Opacity="0.8" />

                <!-- Automap Status Indicator -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="8,0"
                            IsVisible="{Binding IsAutomapActive}" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="#4CAF50" />
                    <TextBlock Text="Automap Running" FontSize="11" FontWeight="SemiBold" Foreground="#4CAF50" />
                </StackPanel>

                <!-- (no pointer coordinates here: the debug overlay shows them when wanted, View > Debug) -->

                <!-- Zoom Controls -->
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" Margin="4,0" VerticalAlignment="Center">
                    <Button Command="{Binding ZoomOutCommand}" Content="-" Padding="4,0" FontSize="12" MinWidth="20" Height="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                    <Slider Value="{Binding ZoomFactor}" Minimum="0.1" Maximum="10.0" Width="80" Height="20" VerticalAlignment="Center" />
                    <Button Command="{Binding ZoomInCommand}" Content="+" Padding="4,0" FontSize="12" MinWidth="20" Height="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="7" Text="{Binding ZoomText}" VerticalAlignment="Center" FontSize="11" MinWidth="40" TextAlignment="Right" />
            </Grid>
        </Border>

        <!-- Main Content Area / Canvas Container -->
        <Grid Background="{DynamicResource SystemControlBackgroundAltMediumBrush}" ColumnDefinitions="*,Auto,Auto">
            <controls:MapCanvasControl x:Name="CanvasControl"
                                       CommandService="{Binding CommandService}"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch" />

            <!-- MinimapControl overlay -->
            <controls:MinimapControl x:Name="Minimap"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,10,10,0"
                                     Width="200"
                                     Height="130"
                                     CanvasControl="{Binding #CanvasControl}"
                                     CommandService="{Binding CommandService}" />

            <!-- Current zoom, bottom-left corner of the canvas -->
            <TextBlock x:Name="ZoomLabel"
                       Text="{Binding ZoomText}"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Bottom"
                       Margin="8,0,0,6"
                       FontSize="11"
                       Foreground="Gray"
                       IsHitTestVisible="False" />

            <!-- directions (satnav), beside the map while open -->
            <controls:DirectionsPanel Grid.Column="1" IsVisible="{Binding IsDirectionsOpen}" />

            <!-- automap's controls, docked beside the map while it runs -->
            <controls:AutomapPanel Grid.Column="2" IsVisible="{Binding IsAutomapActive}" />
        </Grid>
    </DockPanel>
</Window>
