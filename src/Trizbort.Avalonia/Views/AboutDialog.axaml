<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Trizbort.Avalonia.Views.AboutDialog"
        Title="About Trizbort"
        Width="460" Height="320"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid RowDefinitions="*,Auto" Margin="24">
        <StackPanel Grid.Row="0" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Trizbort" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Interactive Fiction Map Editor" FontSize="14" Opacity="0.8" HorizontalAlignment="Center"/>
            <TextBlock Text="Modern Cross-Platform Desktop Edition" FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
            <Separator Margin="0,8"/>
            <TextBlock Text="Powered by Avalonia UI 11.x &amp; .NET 8" FontSize="12" HorizontalAlignment="Center"/>
            <TextBlock Text="Originally created by Genstein, maintained by the IF Community" FontSize="11" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <Button Grid.Row="1"
                Content="OK"
                HorizontalAlignment="Right"
                Width="80"
                Click="OnOkClick"/>
    </Grid>
</Window>
