<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<RootNamespace>Trizbort.Avalonia</RootNamespace>
		<AssemblyName>Trizbort.Avalonia</AssemblyName>
		<Product>Trizbort Recast</Product>
		<Version>0.9</Version>
		<Description>Trizbort Recast: a cross-platform rebuild of the Trizbort interactive fiction map editor.</Description>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Assets\AppIcon\trizbort-recast.ico</ApplicationIcon>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>
		<!-- Canvas cursors converted from the reference .cur files (see Controls/CanvasCursors.cs). -->
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Avalonia" Version="11.3.22" />
		<PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
		<PackageReference Include="Avalonia.Controls.ColorPicker" Version="11.3.22" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
		<PackageReference Include="SkiaSharp" Version="2.88.9" />
		<PackageReference Include="PDFsharp" Version="6.2.4" />
		<!-- PDFsharp 6.2.4 pulls in System.Security.Cryptography.Pkcs 8.0.1 (known vulnerabilities, e.g. GHSA-846f-f764-76mx); pin a patched version. -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Trizbort.Core\Trizbort.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Trizbort.Avalonia.Tests" />
	</ItemGroup>

</Project>
