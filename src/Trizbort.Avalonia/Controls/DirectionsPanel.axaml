<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Trizbort.Avalonia.ViewModels"
             x:Class="Trizbort.Avalonia.Controls.DirectionsPanel"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.small">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
        </Style>
        <Style Selector="Button">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <!-- Directions (satnav): the commands that lead from one room to another along the map's joins. From where
         automap has you, they follow you as you play. -->
    <Border x:Name="PanelBorder" Width="240"
            Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="1,0,0,0">
        <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="12,10,12,8">
                <TextBlock Text="Directions" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" x:Name="CloseButton" Content="Close" Padding="12,3" HorizontalAlignment="Right"
                        Command="{Binding CloseDirectionsCommand}" ToolTip.Tip="Close the directions" />
            </Grid>

            <!-- where you choose the rooms: a box of its own, apart from the directions below -->
            <Border DockPanel.Dock="Top" x:Name="RouteCard" Margin="8,0,8,0" Padding="10,8,10,10" CornerRadius="6"
                    Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
            <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="FROM" />
                <TextBlock x:Name="FromName" Text="{Binding DirectionsFrom}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <!-- only while automapping: automap is what knows where you are -->
                <Button x:Name="WhereYouAreButton" Content="From Where You Are"
                        IsVisible="{Binding IsAutomapActive}"
                        Command="{Binding DirectionsFromWhereYouAreCommand}"
                        ToolTip.Tip="Start from the room automap has you in, and follow you as you play" />
                <TextBlock Classes="section" Text="TO" Margin="0,4,0,0" />
                <TextBlock x:Name="ToName" Text="{Binding DirectionsTo}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="*,6,*" Margin="0,4,0,0">
                    <Button x:Name="GoButton" Content="{Binding GoDirectionsText}" Command="{Binding GoDirectionsCommand}"
                            ToolTip.Tip="{Binding GoDirectionsTip}" />
                    <Button Grid.Column="2" x:Name="SwapButton" Content="⇅ Swap" Command="{Binding SwapDirectionsCommand}"
                            ToolTip.Tip="Directions back the other way" />
                </Grid>
            </StackPanel>
            </Border>

            <!-- the directions, under their own heading -->
            <StackPanel DockPanel.Dock="Top" x:Name="StepsHeading" Margin="12,14,12,4" Spacing="4">
                <TextBlock Classes="section" Text="STEPS" />
                <Border Classes="divider" />
                <TextBlock x:Name="Status" Text="{Binding DirectionsStatus}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="12,4,12,10" Spacing="4">
                <!-- the ways the directions go round, each with Allow to take it again -->
                <StackPanel x:Name="AvoidingPanel" Spacing="4" IsVisible="{Binding IsAvoidingWays}">
                    <TextBlock Classes="section" Text="AVOIDING" />
                    <ItemsControl ItemsSource="{Binding DirectionsAvoiding}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AvoidedWayItem">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                                    <StackPanel Spacing="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Text}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Where}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Allow" Padding="8,2" HorizontalAlignment="Right"
                                            VerticalAlignment="Center" Click="OnAllowWay"
                                            ToolTip.Tip="Let the directions take this way again" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Border Classes="divider" Margin="0,0,0,4" />
                <Button x:Name="CopyButton" Content="Copy Commands" Click="OnCopy"
                        IsEnabled="{Binding HasDirectionsSteps}"
                        ToolTip.Tip="Copy the commands, one a line, to paste into the game" />
                <TextBlock Classes="small"
                           Text="Follows the joins on the map: it can't solve puzzles. Click a step to see where it goes; right-click it to avoid it." />
            </StackPanel>

            <ListBox x:Name="Steps" Margin="8,0" ItemsSource="{Binding DirectionsSteps}"
                     SelectionChanged="OnStepSelected" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:DirectionStepItem">
                        <StackPanel Spacing="1" Background="Transparent">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Avoid This Route" Click="OnAvoidStep"
                                              ToolTip.Tip="Find a way round this step (to get there without a spell, say)" />
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <TextBlock Text="{Binding Text}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Where}" FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
