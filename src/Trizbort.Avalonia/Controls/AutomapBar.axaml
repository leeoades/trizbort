<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Trizbort.Avalonia.Controls.AutomapBar"
             x:Name="root">
    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
        <!-- The status takes what room is left and is cut short to fit, so the buttons never move: the status
             changes as automap works, and a button that moves between press and release doesn't click. -->
        <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center" />
                <TextBlock Text="Automap:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Margin="8,0" Text="{Binding Status, ElementName=root}" FontSize="12"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding Status, ElementName=root}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="Current Room"
                        Command="{Binding CurrentRoomCommand, ElementName=root}"
                        ToolTip.Tip="Select the room automap thinks you're in, and centre the map on it"
                        Padding="12,4"
                        FontSize="12" />
                <Button Content="Previous Move"
                        Command="{Binding BackCommand, ElementName=root}"
                        ToolTip.Tip="Go back a move in the transcript, leaving the map as it is; Next Move plays it again (F9)"
                        Padding="12,4"
                        FontSize="12" />
                <Button Content="Next Move"
                        IsVisible="{Binding IsMoveByMove, ElementName=root}"
                        Command="{Binding NextMoveCommand, ElementName=root}"
                        ToolTip.Tip="Play the transcript's next move, then pause (F10)"
                        Padding="12,4"
                        FontSize="12" />
                <Button Content="Play to End"
                        IsVisible="{Binding IsMoveByMove, ElementName=root}"
                        Command="{Binding PlayToEndCommand, ElementName=root}"
                        ToolTip.Tip="Play the rest of the transcript without pausing, then follow the game as it goes on (F5)"
                        Padding="12,4"
                        FontSize="12" />
                <Button Content="Pause"
                        IsVisible="{Binding !IsMoveByMove, ElementName=root}"
                        Command="{Binding PauseCommand, ElementName=root}"
                        ToolTip.Tip="Pause before the next move, to step through the transcript a move at a time (F10 plays the next move)"
                        Padding="12,4"
                        FontSize="12" />
                <Button Content="Hide Monitor"
                        IsVisible="{Binding IsMonitorShown, ElementName=root}"
                        Command="{Binding ToggleMonitorCommand, ElementName=root}"
                        ToolTip.Tip="Hide the little game monitor (View > Automap Game Monitor brings it back)"
                        Padding="12,4"
                        FontSize="12" />
                <Button Content="Show Monitor"
                        IsVisible="{Binding !IsMonitorShown, ElementName=root}"
                        Command="{Binding ToggleMonitorCommand, ElementName=root}"
                        ToolTip.Tip="Show the game so far on a little monitor"
                        Padding="12,4"
                        FontSize="12" />
                <Button Content="Stop Automapping"
                        Command="{Binding StopCommand, ElementName=root}"
                        Padding="12,4"
                        FontSize="12" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
