<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Trizbort.Avalonia.Controls.AutomapBar"
             x:Name="root">
    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,1,0,0"
            Padding="12,6">
        <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center" />
                <TextBlock Text="Automap:" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Status, ElementName=root}" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Content="Next Move"
                        IsVisible="{Binding IsMoveByMove, ElementName=root}"
                        Command="{Binding NextMoveCommand, ElementName=root}"
                        ToolTip.Tip="Play the transcript's next move, then pause"
                        Padding="12,4"
                        FontSize="12" />
                <Button Content="Play to End"
                        IsVisible="{Binding IsMoveByMove, ElementName=root}"
                        Command="{Binding PlayToEndCommand, ElementName=root}"
                        ToolTip.Tip="Play the rest of the transcript without pausing, then follow the game as it goes on"
                        Padding="12,4"
                        FontSize="12" />
                <Button Content="Pause"
                        IsVisible="{Binding !IsMoveByMove, ElementName=root}"
                        Command="{Binding PauseCommand, ElementName=root}"
                        ToolTip.Tip="Pause before the next move, to step through the transcript a move at a time"
                        Padding="12,4"
                        FontSize="12" />
                <Button Content="Stop Automapping"
                        Command="{Binding StopCommand, ElementName=root}"
                        Padding="12,4"
                        FontSize="12" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
