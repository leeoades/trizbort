		<line id="19" name="" description="" startText="w / u" automapStartTravelled="west up" automapEndTravelled="east down" automapWays="s,d,west,1,w;e,d,east,1,e;s,d,up,1,u;e,d,down,1,d" automapWaysFor="w / u||e / d||" endText="e / d" ZOrder="0">
