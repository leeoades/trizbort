			<dock index="0" id="25" port="ssw" />
			<dock index="1" id="28" port="nne" />
		</line>
		<room id="37" stableId="a2e43971-cda6-4081-94ed-7e34fc0d9c59" name="Low N/S Passage" subtitle="" x="-320" y="1696" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="yes" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You are in a low N/S passage at a hole in the floor. The hole goes down to an E/W passage." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0">
			<objects>bars of silver</objects>
		</room>
		<line id="38" name="" description="" automapStartTravelled="north" automapEndTravelled="south" automapWays="s,d,north,1,n;e,d,south,1,s" automapWaysFor="|||North|South" ZOrder="0">
