		<room id="20" stableId="89cc602f-fe34-43a2-8699-908d154d0a32" name="Orange River Chamber" subtitle="" x="64" y="1216" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="yes" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You are in a splendid chamber thirty feet high. The walls are frozen rivers of orange stone. An awkward canyon and a good passage exit from east and west sides of the chamber." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="21" name="" description="" automapStartTravelled="west" automapEndTravelled="east" automapWays="s,d,west,1,w;e,d,east,1,e" automapWaysFor="|||West|East" ZOrder="0">
			<dock index="0" id="17" port="w" />
			<dock index="1" id="20" port="e" />
		</line>
		<room id="22" stableId="1d548dee-bbab-45a2-bd05-1b9959271b0b" name="At Top of Small Pit" subtitle="" x="-96" y="1216" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="yes" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="At your feet is a small pit breathing traces of white mist. A west passage ends here except for a small crack leading on." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="23" name="" description="" automapStartTravelled="west" automapEndTravelled="east" automapWays="s,d,west,1,w;e,d,east,1,e" automapWaysFor="|||West|East" ZOrder="0">
