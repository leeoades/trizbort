		</line>
		<room id="11" stableId="6c6815d8-e080-4bd8-8940-63a83129b537" name="Below the Grate" subtitle="" x="704" y="1216" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="yes" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You are in a small chamber beneath a 3x3 steel grate to the surface. A low crawl over cobbles leads inward to the west." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
