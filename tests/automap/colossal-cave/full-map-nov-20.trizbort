		<room id="285" stableId="253a2ae1-74de-48c6-89b2-14cc00dff94e" name="At Window on Pit" subtitle="" x="-2880" y="2112" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="yes" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You're at a low window overlooking a huge pit, which extends up out of sight. A floor is indistinctly visible over 50 feet below. Traces of white mist cover the floor of the pit, becoming thicker to the right. Marks in the dust around the window would seem to indicate that someone has been here recently. Directly across the pit from you and 25 feet away there is a similar window looking into a lighted room. A shadowy figure can be seen there peering back at you." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="290" name="" description="" automapStartTravelled="southeast" automapEndTravelled="north" automapWays="s,d,southeast,1,se;e,d,north,1,n" automapWaysFor="|||SouthEast|North" ZOrder="0">
			<dock index="0" id="283" port="se" />
			<dock index="1" id="157" port="n" />
		</line>
