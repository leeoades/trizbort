			<dock index="1" id="37" port="s" />
		</line>
		<room id="40" stableId="c317e2e3-cbac-4b4a-a39e-7ba043235e05" name="At &quot;Y2&quot;" subtitle="" x="-288" y="1536" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="yes" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You are in a large room, with a passage to the south, a passage to the west, and a wall of broken rock to the east. There is a large &quot;Y2&quot; on a rock in the room's center." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="41" name="" description="" automapStartTravelled="north" automapEndTravelled="south" automapWays="s,d,north,1,n;e,d,south,1,s" automapWaysFor="|||North|South" ZOrder="0">
