		<room id="292" stableId="8cd0fc55-decf-4408-8a99-84d3ed6e9b42" name="Sloping Corridor" subtitle="" x="-2208" y="2176" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="yes" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You are in a long winding corridor sloping out of sight in both directions." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="293" name="" description="" automapStartTravelled="southwest" automapEndTravelled="down" automapWays="s,d,southwest,1,sw;e,d,down,1,d" automapWaysFor="||d|SouthWest|" endText="d" ZOrder="0">
			<dock index="0" id="155" port="sw" />
