			<dock index="1" id="288" port="sw" />
		</line>
		<room id="295" stableId="8023b021-3657-448b-a0f5-8a0b4370b752" name="On NE Side of Chasm" subtitle="" x="-2624" y="1600" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="yes" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You are on the far side of the chasm. A northeast path leads away from the chasm on this side." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="296" name="" description="" style="dashed" midText="cross bridge" automapCommand="cross bridge" automapWays="s,c,,1,cross%20bridge" automapWaysFor="|cross bridge|||" ZOrder="0">
			<dock index="0" id="288" port="n" />
			<dock index="1" id="295" port="s" />
		</line>
		<room id="297" stableId="8a6b9d24-893e-4bed-aed1-cf42d7f99f77" name="In Corridor" subtitle="" x="-2464" y="1536" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="yes" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You're in a long east/west corridor. A faint rumbling noise can be heard in the distance." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="298" name="" description="" automapStartTravelled="northeast" automapEndTravelled="west" automapWays="s,d,northeast,1,ne;e,d,west,1,w" automapWaysFor="|||NorthEast|West" ZOrder="0">
			<dock index="0" id="295" port="ne" />
