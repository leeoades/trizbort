		<room id="283" stableId="815a9c6f-72b4-42bb-90cd-d9b452cdfc03" name="Junction of Three Secret Canyons" subtitle="" x="-3008" y="2240" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="yes" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You are in a secret canyon at a junction of three canyons, bearing north, south, and se. The north one is as tall as the other two combined." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
