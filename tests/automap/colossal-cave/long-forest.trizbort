	<map>
		<room id="1" stableId="b7be62ae-34ed-4fc4-9883-110f36b496cb" name="At End Of Road" subtitle="" x="128" y="-544" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" isStartRoom="yes" description="You are standing at the end of a road before a small brick building. Around you is a forest. A small stream flows out of the building and down a gully." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
