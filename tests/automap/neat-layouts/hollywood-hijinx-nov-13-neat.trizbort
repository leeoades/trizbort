		<room id="8" stableId="de28a405-431f-46d0-82b6-2a5e5a444eed" name="Hedge Maze" subtitle="" x="-864" y="672" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You are in a hedge maze of astonishing complexity. Paths lead north, south, east and west." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="34" name="" description="" automapStartTravelled="north" automapEndTravelled="south" ZOrder="0">
			<dock index="0" id="17" port="n" />
			<dock index="1" id="8" port="s" />
		</line>
		<line id="35" name="" description="" ZOrder="0">
			<dock index="0" id="8" port="n" />
			<dock index="1" id="8" port="n" />
		</line>
		<line id="41" name="" description="" ZOrder="0">
			<dock index="0" id="8" port="e" />
			<dock index="1" id="8" port="e" />
		</line>
		<line id="42" name="" description="" ZOrder="0">
			<dock index="0" id="8" port="w" />
			<dock index="1" id="8" port="w" />
		</line>
		<room id="40" stableId="7673bf55-ed4b-4f66-b268-c81c78793019" name="Foyer" subtitle="" x="864" y="896" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="This is the elegant foyer, covered in rich mahogany paneling. Your footsteps echo sharply in this large, hollow space. A broad, graceful staircase sweeps upstairs. Pillared archways beckon you east, west and north. The front door to the south is open. There is a coat closet by the front door. The door to the closet is closed." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="43" name="" description="" automapStartTravelled="north" automapEndTravelled="south" automapWays="s,d,north,1,n;e,d,south,1,s" automapWaysFor="|||North|South" split="yes" ZOrder="0">
			<dock index="0" id="2" port="n" />
			<dock index="1" id="40" port="s" />
		</line>
		<line id="44" name="" description="" automapWays="s,d,north,0,n" automapWaysFor="|||North|" ZOrder="0">
			<dock index="0" id="40" port="n" />
			<dock index="1" id="40" port="n" />
		</line>
		<line id="45" name="" description="" automapWays="s,d,east,0,e" automapWaysFor="|||East|" ZOrder="0">
			<dock index="0" id="40" port="e" />
			<dock index="1" id="40" port="e" />
		</line>
		<room id="46" stableId="35c0ee81-550e-4112-8ef2-c5738860f88f" name="Living Room" subtitle="" x="672" y="896" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="This is the living room where Uncle Buddy and Aunt Hildegarde used to spend their evenings. Most of the west wall is covered by a grand stone fireplace with a mantle over it. A long sofa, several cushy chairs and a telephone fill the room. Most of the hardwood floor is covered by a monstrous Persian rug. A doorway leads north and an archway exits to the east." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="47" name="" description="" automapStartTravelled="west" automapEndTravelled="east" automapWays="s,d,west,1,w;e,d,east,1,e" automapWaysFor="|||West|East" ZOrder="0">
			<dock index="0" id="40" port="w" />
			<dock index="1" id="46" port="e" />
		</line>
		<room id="50" stableId="20885901-0bbe-4f72-bfd2-51e721d32275" name="Closet" subtitle="Ground Floor" x="1024" y="1216" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" moves="yes" description="You're in a small closet. Mounted at an angle on the back wall of the closet are three coat pegs. To the left of the first peg there is a hole the size of a peg. To the right of the third peg there is a peg which has been sawed-off, flush with the wall. The door to the north is open." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="51" name="" description="" startText="in / enter closet" automapStartTravelled="in" automapEndTravelled="out north" automapWays="s,d,in,1,in;e,d,out,1,out;s,c,,1,enter%20closet;e,d,north,1,n" automapWaysFor="in|enter closet|n / out||" endText="n / out" ZOrder="0">
			<dock index="0" id="40" port="sse" />
			<dock index="1" id="50" port="n" />
		</line>
		<room id="52" stableId="c1a41274-a83d-496a-a3ee-f5f0abe9ca49" name="Closet" subtitle="Floor -1" x="479.99997" y="1216" w="96" h="64" region="NoRegion" referenceRoom="50" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You're in a small closet. Mounted at an angle on the back wall of the closet are three coat pegs. To the left of the first peg there is a hole the size of a peg. To the right of the third peg there is a peg which has been sawed-off, flush with the wall. The door to the north is open." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="53" name="" description="" style="dashed" startText="Pull first peg" automapCommand="open door" automapWays="s,c,,1,open%20door" automapWaysFor="|open door|||" endText="Pull second peg" ZOrder="0">
			<dock index="0" id="50" port="w" />
			<dock index="1" id="52" port="e" />
		</line>
		<room id="54" stableId="2a6976a8-790a-43d4-a90d-7c583b007119" name="Cellar" subtitle="" x="479.99997" y="1088" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You are in a musty cellar. One of Uncle Buddy's old movie props, a huge, over- teched computer is here. There is an open closet door to the south. A staircase leads up." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="55" name="" description="" startText="n / out" automapStartTravelled="out north" automapEndTravelled="south" automapWays="s,d,out,1,out;e,d,south,1,s;s,d,north,1,n" automapWaysFor="n / out||||South" ZOrder="0">
			<dock index="0" id="52" port="n" />
			<dock index="1" id="54" port="s" />
		</line>
		<room id="56" stableId="ca0620b5-3449-467b-87a5-d7b3b68eef9e" name="Kitchen" subtitle="" x="479.99997" y="768" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="This is Aunt Hildegarde's kitchen. It is a fairly large, sterile area with several pieces of commercial-grade equipment to handle the vast amount of food needed for Hollywood parties. It is not exactly the kind of homey kitchen most people's aunts have. The whole family remembers the Christmas everyone received fruit cakes with serial numbers on them. A doorway leads to the east and stairs lead down from here." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="57" name="" description="" startText="u" automapStartTravelled="up" automapEndTravelled="down" automapWays="s,d,up,1,u;e,d,down,1,d" automapWaysFor="u||d||" endText="d" ZOrder="0">
			<dock index="0" id="54" port="nnw" />
			<dock index="1" id="56" port="s" />
		</line>
		<room id="58" stableId="2137f686-c148-4b53-ae23-eeece6235fb5" name="Dining Room" subtitle="" x="672" y="768" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="This is the dining room with a long, walnut table and seating for twelve. You remember more than one evening falling asleep at the table while Uncle Buddy rambled on about the way Hollywood used to be. A large picture window looks out on the garden. Doorways lead east, west and south." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="59" name="" description="" automapStartTravelled="east" automapEndTravelled="west" automapWays="s,d,east,1,e;e,d,west,1,w" automapWaysFor="|||East|West" ZOrder="0">
			<dock index="0" id="56" port="e" />
			<dock index="1" id="58" port="w" />
		</line>
		<line id="61" name="" description="" automapWays="s,d,east,0,e" automapWaysFor="|||East|" ZOrder="0">
			<dock index="0" id="58" port="e" />
			<dock index="1" id="58" port="e" />
		</line>
		<line id="60" name="" description="" automapStartTravelled="south" automapEndTravelled="north" automapWays="s,d,south,1,s;e,d,north,1,n" automapWaysFor="|||South|North" ZOrder="0">
			<dock index="0" id="58" port="s" />
