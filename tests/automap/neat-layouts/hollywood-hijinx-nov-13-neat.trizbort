		</line>
		<room id="62" stableId="946856d1-e285-4538-b808-ca20b037e551" name="In the Chimney" subtitle="" x="128" y="768" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You're in the chimney, above the fireplace. You can see a couple of holes here in the chimney where bricks used to be. The chimney continues upward and the fireplace is below." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="63" name="" description="" startText="u" automapStartTravelled="up" automapEndTravelled="down" automapWays="s,d,up,1,u;e,d,down,1,d" automapWaysFor="u||d||" endText="d" ZOrder="0">
