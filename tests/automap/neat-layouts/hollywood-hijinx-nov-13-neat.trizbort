		</line>
		<room id="48" stableId="7e1ce5df-9319-4b12-b06e-b574a4818f54" name="Fireplace" subtitle="" x="128" y="896" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="The fireplace is finely crafted masonry, but has long been neglected. The mortar is crumbling in a number of places. One brick, about waist high, seems particularly loose. The fireplace opens to the east." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0">
			<objects>brick|indigo punch card</objects>
		</room>
		<line id="49" name="" description="" startText="enter fireplace" automapStartTravelled="command" automapEndTravelled="east" automapWays="s,c,,1,enter%20fireplace;e,d,east,1,e" automapWaysFor="enter fireplace||||East" ZOrder="0">
			<dock index="0" id="46" port="w" />
