<?xml version="1.0" encoding="utf-8"?>
<trizbort version="1.0.0.0">
	<info />
	<map>
		<room id="1" stableId="d13d27a3-9ff8-4249-a8cb-4f5d4b300778" name="South Junction" subtitle="" x="-864" y="1664" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" isStartRoom="yes" description="You're standing in front of the house where you spent many of your summers as a youngster. The old place is not as big as it seemed to you then, but it is still quite large. Stone pathways wind east and west around the house, and a larger main walkway leads north." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0">
			<objects>statue</objects>
		</room>
		<room id="3" stableId="22c9a1ce-b8ba-4db1-b5bc-62ae958d7c68" name="Southeast Junction" subtitle="" x="-576" y="1344" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="This is the southeastern corner of a large backyard whose main feature is an elaborate garden. The stone walkway splits in three directions here: north, along the perimeter of the garden; south, around the side of the house; and west, where the walkway ends at a couple of steps leading up." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="5" name="" description="" automapStartTravelled="east" automapEndTravelled="south" automapWays="s,d,east,1,e;e,d,south,1,s" automapWaysFor="|||East|South" ZOrder="0">
			<dock index="0" id="1" port="e" />
			<dock index="1" id="3" port="s" />
		</line>
		<room id="7" stableId="eb28f302-ca2e-403c-b4a8-bfc66055babe" name="Patio" subtitle="" x="-864" y="1344" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="This is a large fieldstone patio spanning the entire width of the back of the house. In the daytime you can look out onto Aunt Hildegarde's beautiful garden, said to be the envy of the Malibu colony. This is where Uncle Buddy and Aunt Hildegarde would often entertain." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0">
			<objects>orange punch card</objects>
		</room>
		<line id="9" name="" description="" automapStartTravelled="west" automapEndTravelled="east" ZOrder="0">
			<dock index="0" id="3" port="w" />
			<dock index="1" id="7" port="e" />
		</line>
		<room id="2" stableId="d2f4ebbd-9076-4be3-a412-3ccecc3329e7" name="Front Porch" subtitle="" x="-864" y="1536" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You're standing on the front porch of the house. Next to the front door is a regulation mailbox endorsed by Buck Palace. Beneath the mailbox is a doorbell once rung by Sonny Tufts. To the south is a walkway." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0">
			<objects at="n" placed="yes" custom="yes" customRight="52" customDown="45">mailbox|- The Status Line|- yellowed piece of paper|- business card</objects>
		</room>
		<line id="10" name="" description="" automapStartTravelled="north" automapEndTravelled="south" automapWays="s,d,north,1,n;e,d,south,1,s" automapWaysFor="|||North|South" ZOrder="0">
			<dock index="0" id="1" port="n" />
			<dock index="1" id="2" port="s" />
		</line>
		<room id="4" stableId="7870298a-34b4-4f47-b9ab-fcbcf79cbd3f" name="Southwest Junction" subtitle="" x="-1152" y="1344" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="This is the southwestern corner of a large backyard whose main feature is an elaborate garden. The stone walkway splits in three directions here: north, along the perimeter of the garden; south, around the side of the house; and east, where the walkway ends at the foot of a couple of steps." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="11" name="" description="" automapStartTravelled="west" automapEndTravelled="south" automapWays="s,d,west,1,w;e,d,south,1,s" automapWaysFor="|||West|South" ZOrder="0">
			<dock index="0" id="1" port="w" />
			<dock index="1" id="4" port="s" />
		</line>
		<line id="13" name="" description="" automapStartTravelled="east" automapEndTravelled="west" automapWays="s,d,east,1,e;e,d,west,1,w" automapWaysFor="|||East|West" ZOrder="0">
			<dock index="0" id="4" port="e" />
			<dock index="1" id="7" port="w" />
		</line>
		<room id="12" stableId="f9e631db-5882-4eef-9ecb-975a83e5f0dc" name="Northwest Junction" subtitle="" x="-1152" y="800" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="In this corner of the backyard you can make out the enormous hedge, which is part of the estate's hedge maze. The stone walkway splits in three directions here: north, along the dark and towering hedge; south, past the fragrant and inviting garden; and east, where the walkway cuts a straight and narrow path between the hedge and the garden." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="15" name="" description="" automapStartTravelled="north" automapEndTravelled="south" ZOrder="0">
			<dock index="0" id="4" port="n" />
			<dock index="1" id="12" port="s" />
		</line>
		<room id="17" stableId="caa9e4d8-f213-4939-85b9-87cbd269d820" name="Entrance to Hedge Maze" subtitle="" x="-864" y="800" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="This is the entrance to the hedge maze. Aunt Hildegarde told you never to go into the maze without the map, and of course you would go in anyway and she would have to come in and find you." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="18" name="" description="" automapStartTravelled="east" automapEndTravelled="west" ZOrder="0">
			<dock index="0" id="12" port="e" />
			<dock index="1" id="17" port="w" />
		</line>
		<room id="19" stableId="5d4ae389-a01a-412f-ba19-2bc49c06349c" name="Northeast Junction" subtitle="" x="-576" y="800" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="In this corner of the backyard you can make out the enormous hedge, which is part of the estate's hedge maze. The stone walkway splits in three directions here: north, along the dark and towering hedge; south, past the fragrant and inviting garden; and west, where the walkway cuts a straight and narrow path between the hedge and the garden. A slightly worn path in the grass heads east." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="20" name="" description="" automapStartTravelled="east" automapEndTravelled="west" automapWays="s,d,east,1,e;e,d,west,1,w" automapWaysFor="|||East|West" ZOrder="0">
			<dock index="0" id="17" port="e" />
			<dock index="1" id="19" port="w" />
		</line>
		<line id="22" name="" description="" automapStartTravelled="south" automapEndTravelled="north" automapWays="s,d,south,1,s;e,d,north,1,n" automapWaysFor="|||South|North" ZOrder="0">
			<dock index="0" id="19" port="s" />
			<dock index="1" id="3" port="n" />
		</line>
		<room id="6" stableId="4f84540c-ab13-459c-a54b-215b04b8d5a1" name="Cannon Emplacement" subtitle="" x="-864" y="480" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="This is a cannon emplacement complete with a Civil War-style cannon and a neatly stacked pyramid of cannon balls. During the day this area affords a spectacular view of the coastline. Stone walkways lead east and west, and a steep path leads down." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="16" name="" description="" automapStartTravelled="north" automapEndTravelled="west" ZOrder="0">
			<dock index="0" id="12" port="n" />
			<dock index="1" id="6" port="w" />
		</line>
		<line id="24" name="" description="" automapStartTravelled="east" automapEndTravelled="north" ZOrder="0">
			<dock index="0" id="6" port="e" />
			<dock index="1" id="19" port="n" />
		</line>
		<room id="21" stableId="feae113d-f9fd-4f02-a1e9-c1e25aa7dfa5" name="Cliff" subtitle="" x="-864" y="352" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="This cliff affords the same spectacular view as from the cannon emplacement above. Far below you and stretching east, are the white sands of a beach, illuminated by the moon's glow. You can hear the faint sound of waves lapping at the shore. Nearby in the ground is a closed hatch." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0">
			<objects placed="yes" custom="yes" customRight="30" customDown="3">ladder|hatch</objects>
		</room>
		<line id="25" name="" description="" startText="north / down" automapStartTravelled="down north" automapEndTravelled="up south" endText="south / up" ZOrder="0">
			<dock index="0" id="6" port="n" />
			<dock index="1" id="21" port="s" />
		</line>
		<room id="23" stableId="7779aa7d-08f3-41af-a1ec-bfa79fd5477d" name="Top Landing" subtitle="" x="-384" y="800" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="This is a rickety landing at the top of a long flight of old, wooden stairs leading down to the beach far below. You and Cousin Herman would race down these stairs in the summertime to see who would get to the water first. Usually Cousin Herman would trip you and win. A path in the grass leads west." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="26" name="" description="" automapStartTravelled="east" automapEndTravelled="west" ZOrder="0">
			<dock index="0" id="19" port="e" />
			<dock index="1" id="23" port="w" />
		</line>
		<room id="27" stableId="eccd9d02-3a3f-40a8-ba35-ff4ce45faa2a" name="Middle of Beach Stairs" subtitle="" x="-384" y="672" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You're about halfway down the steep staircase, which creaks under your weight. There are several steps missing here. It's quite a gap: probably more than you could jump across. On the other side of the gap, the stairs continue down. Climbing up the stairs returns to the landing." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="29" name="" description="" startText="north / down" automapStartTravelled="down north" automapEndTravelled="up south" endText="south / up" ZOrder="0">
			<dock index="0" id="23" port="n" />
			<dock index="1" id="27" port="s" />
		</line>
		<room id="14" stableId="ddefde15-59dc-477a-af2e-021c201a7400" name="Garden, North" subtitle="" x="-864" y="960" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You are in the orchid section of the garden. Tender orchid petals of every color surround a small pond here. The stone walkway leads north, southeast and southwest." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="28" name="" description="" automapStartTravelled="south" automapEndTravelled="north" automapWays="s,d,south,1,s;e,d,north,1,n" automapWaysFor="|||South|North" ZOrder="0">
			<dock index="0" id="17" port="s" />
			<dock index="1" id="14" port="n" />
		</line>
		<room id="30" stableId="fcc584be-ddea-4bab-9f74-aab679ed78d6" name="Garden, East" subtitle="" x="-704" y="1088" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You are in the overpoweringly fragrant rose bush section of the garden. As you admire the roses you notice one somewhat sickly rose bush. Something about the sight of this particular rose bush makes you feel a bit queasy. The stone walkway leads northwest and southwest." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="31" name="" description="" automapStartTravelled="southeast" automapEndTravelled="northwest" ZOrder="0">
			<dock index="0" id="14" port="se" />
			<dock index="1" id="30" port="nw" />
		</line>
		<room id="33" stableId="4b2adcd8-607d-492b-81bb-c6e248cb4d79" name="Garden, South" subtitle="" x="-864" y="1216" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You're standing on a stone walkway in Aunt Hildegarde's much envied garden where she would spend hours tending to her flowers, bushes and trees. The garden was off limits to you as a child because of an incident one summer when you and Cousin Herman were playing in the garden. You suggested pretending to be wild African animals and climbed a tree and began to screech as if a baboon while Cousin Herman ran off toward the roses shouting something about being a rhinoceros." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="36" name="" description="" automapStartTravelled="southwest" automapEndTravelled="northeast" ZOrder="0">
			<dock index="0" id="30" port="sw" />
			<dock index="1" id="33" port="ne" />
		</line>
		<room id="37" stableId="2b8308f0-a8bb-4cc8-88a8-33ef066aba0a" name="Garden, West" subtitle="" x="-1024" y="1088" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You're standing on a stone walkway in the tulip section of the garden. The walkway leads northeast and southeast." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0">
			<objects at="e" placed="yes" custom="yes" customRight="-93" customDown="42">small shovel</objects>
		</room>
		<line id="38" name="" description="" automapStartTravelled="northwest" automapEndTravelled="southeast" automapWays="s,d,northwest,1,nw;e,d,southeast,1,se" automapWaysFor="|||NorthWest|SouthEast" ZOrder="0">
			<dock index="0" id="33" port="nw" />
			<dock index="1" id="37" port="se" />
		</line>
