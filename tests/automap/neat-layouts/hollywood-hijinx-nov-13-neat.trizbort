		<room id="66" stableId="e54245d1-a939-424f-bb61-21ae7aa3f1a3" name="West End of Roof" subtitle="" x="128" y="512" w="96" h="64" region="NoRegion" handDrawn="no" handDrawnStyle="MapDefault" allcornersequal="yes" ellipse="no" roundedCorners="no" octagonal="no" cornerTopLeft="15" cornerTopRight="15" cornerBottomLeft="15" cornerBottomRight="15" borderstyle="Solid" placedByHand="yes" description="You're doing your best to keep your balance here on the roof. During a fierce storm you can see Linda Ronstadt's house wash into the ocean from here. A chimney juts up from the roof here and there is another chimney to the east, near the end of the roof." roomFill="" secondFill="" secondFillLocation="Bottom" roomBorder="" roomLargeText="" roomSubtitleColor="" roomSmallText="" ZOrder="0" />
		<line id="67" name="" description="" startText="u" automapStartTravelled="up" automapEndTravelled="down" automapWays="s,d,up,1,u;e,d,down,1,d" automapWaysFor="u||d||" endText="d" ZOrder="0">
