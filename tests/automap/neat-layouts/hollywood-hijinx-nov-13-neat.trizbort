			<dock index="0" id="37" port="ne" />
			<dock index="1" id="14" port="sw" />
		</line>
		<line id="32" name="" description="" automapStartTravelled="south" automapEndTravelled="north" automapWays="s,d,south,1,s;e,d,north,1,n" automapWaysFor="|||South|North" ZOrder="0">
